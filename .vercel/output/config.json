{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/add/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/checkin/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/edit/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/events/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/registrations/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin/?$",
			"dest": "_render"
		},
		{
			"src": "^/checkout/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/events/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/jersey/?$",
			"dest": "_render"
		},
		{
			"src": "^/kontak/?$",
			"dest": "_render"
		},
		{
			"src": "^/medali/?$",
			"dest": "_render"
		},
		{
			"src": "^/panduan/?$",
			"dest": "_render"
		},
		{
			"src": "^/regulasi/?$",
			"dest": "_render"
		},
		{
			"src": "^/rute/?$",
			"dest": "_render"
		},
		{
			"src": "^/ticket/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}