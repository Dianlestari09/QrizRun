---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Platform Pendaftaran Event Olahraga No. 1 di Indonesia",
} = Astro.props;
---

<!doctype html>
<html lang="id" style="overflow-x: clip;">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Syiar QRIS Run</title>
  </head>
  <body style="overflow-x: clip; position: relative; width: 100%;">
    <header class="header glass">
      <div class="container header-container">
        <!-- Logo Image Placeholder -->
        <a href="/" class="logo">
          <img
            src="/logo.webp"
            alt="Logo Syiar QRIS Run"
            id="main-logo"
            class="navbar-logo-img"
          />
        </a>

        <nav class="nav">
          <a href="/" class="nav-link">Beranda</a>

          <div class="nav-dropdown">
            <button class="nav-link dropdown-toggle" aria-expanded="false"
              >Informasi <span class="arrow">▾</span></button
            >
            <div class="dropdown-menu">
              <a href="/jersey" class="dropdown-item">Jersey</a>
              <a href="/medali" class="dropdown-item">Medali</a>
              <a href="/rute" class="dropdown-item">Rute</a>
              <a href="/panduan" class="dropdown-item">Panduan Pendaftaran</a>
            </div>
          </div>

          <a href="/regulasi" class="nav-link">Regulasi</a>
          <a href="/kontak" class="nav-link">Kontak</a>
        </nav>

        <div class="header-actions">
          <a href="/events/1" class="nav-link btn-buy-ticket desktop-only">Daftar</a
          >
          <button
            class="mobile-menu-btn"
            id="mobile-menu-toggle"
            aria-label="Toggle Menu"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <!-- Mobile Nav -->
      <div class="mobile-nav" id="mobile-nav">
        <a href="/" class="mobile-nav-link">Beranda</a>
        <button class="mobile-nav-link" id="mobile-info-toggle" style="width: 100%; text-align: left; background: none; border: none; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: inherit; font-family: inherit; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0;">
          Informasi <span class="arrow" style="font-size: 0.8em; transition: transform 0.2s;">▾</span>
        </button>
        <div class="mobile-dropdown-menu" id="mobile-info-menu" style="display: none; flex-direction: column; padding-left: 1.5rem; background: rgba(0,0,0,0.1); border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
          <a href="/jersey" class="mobile-nav-link" style="border-bottom: 1px dashed rgba(255,255,255,0.05); font-size: 1rem;">Jersey</a>
          <a href="/medali" class="mobile-nav-link" style="border-bottom: 1px dashed rgba(255,255,255,0.05); font-size: 1rem;">Medali</a>
          <a href="/rute" class="mobile-nav-link" style="border-bottom: 1px dashed rgba(255,255,255,0.05); font-size: 1rem;">Rute</a>
          <a href="/panduan" class="mobile-nav-link" style="border-bottom: none; font-size: 1rem;">Panduan Pendaftaran</a>
        </div>
        <a href="/regulasi" class="mobile-nav-link">Regulasi</a>
        <a href="/kontak" class="mobile-nav-link">Kontak</a>
        <a href="/events/1" class="mobile-nav-link" style="background-color: var(--accent); color: var(--bg-primary) !important; padding: 0.8rem 3rem; border-radius: 12px; text-align: center; margin-top: 1rem; border-bottom: none; font-weight: 800; display: block;">Daftar</a>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="footer glass">
      <div class="container footer-grid">
        <div class="footer-brand">
          <div class="logo">
            <img
              src="/logo.webp"
              alt="Logo Syiar QRIS Run"
              class="navbar-logo-img"
            />
          </div>
          <p class="footer-desc">
            Syiar QRIS Run 2026 merupakan ajang lari yang diselenggarakan oleh Bank Indonesia Kediri untuk mengajak masyarakat menerapkan gaya hidup sehat sekaligus mendukung percepatan digitalisasi sistem pembayaran melalui QRIS.
          </p>
        </div>
        <div class="footer-links">
          <h4>Informasi</h4>
          <a href="/">Beranda</a>
          <a href="/jersey">Jersey</a>
          <a href="/medali">Medali</a>
          <a href="/rute">Rute</a>
        </div>
        <div class="footer-links">
          <h4>Layanan</h4>
          <a href="/events/1">Daftar Event</a>
          <a href="/regulasi">Regulasi</a>
          <a href="/kontak">Kontak</a>
        </div>
        <div class="footer-social">
          <h4>Ikuti Kami</h4>
          <div class="social-icons">
            <a href="https://youtube.com/@bankindonesiakediri" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 7.1c.3-1.5 1.5-2.7 3-3 2.5-.5 6.5-.5 6.5-.5s4 0 6.5.5c1.5.3 2.7 1.5 3 3 .5 2.5.5 4.9.5 4.9s0 2.4-.5 4.9c-.3 1.5-1.5 2.7-3 3-2.5.5-6.5.5-6.5.5s-4 0-6.5-.5c-1.5-.3-2.7-1.5-3-3-.5-2.5-.5-4.9-.5-4.9s0-2.4.5-4.9z"/><path d="m10 15 5-3-5-3v6z"/></svg>
            </a>
            <a href="https://x.com/KPwBi_kediri" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>
            </a>
            <a href="https://instagram.com/bank_indonesia_kediri" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="https://tiktok.com/@bank.indonesia.ke" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Syiar QRIS Run. All rights reserved.</p>
      </div>
    </footer>

    <!-- WhatsApp Floating Icon -->
    <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="wa-float" title="Hubungi Admin">
      <svg viewBox="0 0 32 32" width="32" height="32" fill="currentColor">
        <path d="M16 2a13 13 0 0 0-11 20l-2 5 5-2a13 13 0 1 0 8-23zm0 24a11 11 0 0 1-5-1l-3 1 1-3a11 11 0 1 1 7 3zm6-8c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.1-.7.1s-.8 1-1 1.2c-.2.2-.4.2-.7.1-.3-.1-1.2-.5-2.2-1.4-1-.8-1.5-1.4-1.7-1.7-.2-.3 0-.4.1-.6s.3-.4.5-.6.2-.4.3-.6.1-.5-.1-.7c-.1-.3-.7-1.6-1-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.6.1-.9.4s-1.1 1.1-1.1 2.7 1.1 3.1 1.3 3.3 2.2 3.4 5.3 4.7c3.1 1.3 3.1.9 3.7.8s1.7-.7 1.9-1.4.2-1.3.1-1.4c-.2-.1-.4-.2-.7-.3z"/>
      </svg>
    </a>

    <script>
      const toggleBtn = document.getElementById("mobile-menu-toggle");
      const mobileNav = document.getElementById("mobile-nav");

      if (toggleBtn && mobileNav) {
        toggleBtn.addEventListener("click", () => {
          mobileNav.classList.toggle("active");
          toggleBtn.classList.toggle("active");
        });
      }

      const infoToggle = document.getElementById("mobile-info-toggle");
      const infoMenu = document.getElementById("mobile-info-menu");
      if (infoToggle && infoMenu) {
        infoToggle.addEventListener("click", () => {
          const arrow = infoToggle.querySelector<HTMLElement>(".arrow");
          if (infoMenu.style.display === "none") {
            infoMenu.style.display = "flex";
            if (arrow) arrow.style.transform = "rotate(180deg)";
          } else {
            infoMenu.style.display = "none";
            if (arrow) arrow.style.transform = "rotate(0deg)";
          }
        });
      }
    </script>
  </body>
</html>

<style>
  /* Header Styles */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    height: 72px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    background: linear-gradient(to bottom right, var(--bg-primary) 0%, #201a4e 40%, var(--primary) 100%), rgba(43, 119, 223, 0.5);
    background-blend-mode: overlay;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .navbar-logo-img {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  /* Dropdown Styles */
  .nav-dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown-toggle {
    background: none;
    border: none;
    color: inherit;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0;
  }

  .dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: rgba(43, 119, 223, 0.95); /* Match navbar color but more opaque */
    min-width: 160px;
    box-shadow: var(--shadow-md);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 1000;
    padding: 0.5rem 0;
  }

  .nav-dropdown:hover .dropdown-menu {
    display: block;
  }

  .dropdown-menu a {
    color: #ffffff; /* White text for dropdown items */
    padding: 0.75rem 1.5rem;
    display: block;
    font-size: 0.9rem;
    transition: background 0.2s;
  }

  .dropdown-menu a:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--accent);
  }

  .nav-link.btn-buy-ticket {
    background: var(--accent);
    color: var(--bg-primary) !important;
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    font-weight: 800;
    margin-left: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 8px 18px rgba(232, 186, 70, 0.22);
  }
  .nav-link.btn-buy-ticket:hover {
    box-shadow: var(--shadow-accent);
    transform: translateY(-2px);
  }
  .desktop-only {
    display: none;
  }
  @media (min-width: 768px) {
    .desktop-only {
      display: inline-block;
    }
  }

  .nav {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff; /* White text for navbar links */
    padding: 0.5rem 0.25rem;
    position: relative;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--accent);
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .admin-tag {
    color: var(--primary);
  }
  .admin-tag:hover {
    color: #60a5fa;
  }
  .admin-tag::after {
    background-color: var(--primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .admin-btn {
    padding: 0.5rem 1.2rem;
    font-size: 0.85rem;
    border-color: var(--primary);
    color: var(--primary);
  }
  .admin-btn:hover {
    background-color: rgba(45, 130, 255, 0.1);
    border-color: var(--primary);
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 101;
  }

  .mobile-menu-btn span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    transition: all 0.3s ease;
  }

  .mobile-menu-btn.active span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }
  .mobile-menu-btn.active span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-nav {
    display: flex;
    position: fixed;
    top: 72px;
    right: 0;
    transform: translateX(100%);
    visibility: hidden;
    width: 280px;
    height: calc(100vh - 72px);
    background: var(--bg-secondary);
    border-left: 1px solid var(--border-color);
    padding: 1.5rem;
    flex-direction: column;
    gap: 1.25rem;
    z-index: 99;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    box-shadow: -5px 0 15px rgba(0,0,0,0.3);
  }

  .mobile-nav.active {
    transform: translateX(0);
    visibility: visible;
  }

  .mobile-nav-link {
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Main content */
  .main-content {
    min-height: calc(100vh - 72px - 300px);
  }

  /* Footer Styles */
  .footer {
    border-top: 1px solid var(--border-color);
    padding: 2rem 0;
    margin-top: 0;
    position: relative;
    z-index: 10;
    background: linear-gradient(to bottom right, var(--bg-primary) 0%, #201a4e 40%, var(--primary) 100%), rgba(43, 119, 223, 0.5);
    background-blend-mode: overlay;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 320px;
  }

  .footer-links,
  .footer-social {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-links h4,
  .footer-social h4 {
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .footer-links a {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .social-icons {
    display: flex;
    gap: 1rem;
  }

  .social-icons a {
    width: 36px;
    height: 36px;
    border-radius: 8px; /* Rounded square */
    background-color: var(--bg-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white; /* White icon color */
  }

  .social-icons a:hover {
    background-color: var(--accent);
    color: #000;
    box-shadow: var(--shadow-accent);
  }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .navbar-logo-img {
      height: 30px;
    }
    /* Pastikan tombol 'Daftar' di header tidak terlihat pada layar mobile */
    .nav-link.btn-buy-ticket {
      display: none !important;
    }

    .nav,
    .header-actions .admin-btn {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand,
    .footer-social {
      grid-column: 1 / -1;
    }
  }
</style>
