---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kontak - Waru Turi Fun Run 2026">
  <!-- Header / Contact Info Section -->
  <section class="kontak-section section-padding">
    <div class="container kontak-container">
      <div class="kontak-header">
        <span class="badge-blue">SUPPORT CENTER</span>
        <h1 class="page-title">
          Ada Pertanyaan? <br class="mobile-hidden" /><span
            class="text-accent italic">Kami Siap Membantu.</span>
        </h1>
        <p class="page-subtitle">
          Tim kami berdedikasi untuk memberikan pengalaman lari terbaik bagi
          Anda. Jangan ragu untuk menghubungi kami melalui saluran di bawah ini.
        </p>
      </div>

      <div class="kontak-card glass">
        <h2 class="card-title text-accent">Informasi Kontak</h2>

        <div class="contact-list">
          <div class="contact-item">
            <div class="contact-icon-wrapper">
              <span class="contact-icon">📍</span>
            </div>
            <div class="contact-info">
              <span class="contact-label">LOKASI</span>
              <p class="contact-value">
                Bendung Gerak Waru Turi, Gampengrejo, Kediri, Jawa Timur
              </p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon-wrapper">
              <span class="contact-icon">💬</span>
            </div>
            <div class="contact-info">
              <span class="contact-label">WHATSAPP</span>
              <p class="contact-value">+62 812-3456-7890</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon-wrapper">
              <span class="contact-icon">✉️</span>
            </div>
            <div class="contact-info">
              <span class="contact-label">EMAIL</span>
              <p class="contact-value">event@waruturirun.com</p>
            </div>
          </div>
        </div>
      </div>

      <div class="social-section">
        <p class="social-label">IKUTI PERJALANAN KAMI</p>
        <div class="social-icons">
          <a href="#" class="social-btn">IG</a>
          <a href="#" class="social-btn">🔗</a>
          <a href="#" class="social-btn">▶️</a>
          <a href="#" class="social-btn">🌐</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="map-section section-padding">
    <div class="container">
      <div class="map-header">
        <div class="map-title-area">
          <span class="badge-blue">VENUE RACE</span>
          <h2 class="section-title">Lokasi Start & Finish</h2>
        </div>
        <a
          href="https://maps.google.com"
          target="_blank"
          rel="noopener noreferrer"
          class="maps-link"
        >
          Buka di Google Maps <span class="external-icon">↗</span>
        </a>
      </div>

      <div class="map-container glass">
        <img
          src="/map-placeholder.png"
          alt="Peta Lokasi Waru Turi Fun Run"
          class="map-image"
        />
        <div class="map-pin">
          <div class="pin-icon-wrapper">
            <span class="pin-icon">🚩</span>
          </div>
          <span class="pin-text">Main Event Area</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-padding {
    padding: 80px 0;
  }

  .text-accent {
    color: var(--accent);
  }

  .italic {
    font-style: italic;
  }

  .badge-blue {
    display: inline-block;
    background-color: rgba(43, 73, 143, 0.3);
    border: 1px solid #4a72d6;
    color: #9bbcf2;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  /* Kontak Section */
  .kontak-section {
    background-color: var(--bg-primary);
    padding-top: 120px; /* Memberi ruang untuk navbar */
  }

  .kontak-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .kontak-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    color: var(--neutral-white);
  }

  .page-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto;
  }

  /* Kontak Card */
  .kontak-card {
    background: var(--card-bg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 3rem;
    margin-bottom: 3rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .contact-icon-wrapper {
    width: 48px;
    height: 48px;
    background-color: rgba(43, 73, 143, 0.5); /* Biru gelap transparan */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-icon {
    font-size: 1.3rem;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contact-label {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .contact-value {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--neutral-white);
    margin: 0;
  }

  /* Social Section */
  .social-section {
    text-align: center;
  }

  .social-label {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--text-secondary);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .social-icons {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .social-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--neutral-white);
    text-decoration: none;
    transition: all 0.2s;
    font-size: 1.1rem;
  }

  .social-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-3px);
  }

  /* Map Section */
  .map-section {
    background-color: var(--bg-secondary);
  }

  .map-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--neutral-white);
  }

  .maps-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.2s;
    margin-bottom: 0.5rem;
  }

  .maps-link:hover {
    opacity: 0.8;
  }

  .external-icon {
    font-size: 1.2rem;
  }

  .map-container {
    position: relative;
    width: 100%;
    height: 400px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: #1a1a2e; /* Placeholder warna gelap */
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .map-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.7;
    transition: opacity 0.3s;
    display: block;
  }

  .map-image:hover {
    opacity: 0.9;
  }

  .map-pin {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    pointer-events: none;
  }

  .pin-icon-wrapper {
    background-color: #2b498f;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid #ffffff;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
  }

  .pin-icon {
    font-size: 1.2rem;
  }

  .pin-text {
    background-color: #111827;
    color: #ffffff;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2.2rem;
    }

    .kontak-card {
      padding: 2rem 1.5rem;
    }

    .map-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .map-container {
      height: 300px;
    }
  }
</style>
