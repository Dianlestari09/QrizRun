---
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import { getUpcomingEvents, getFinishedEvents } from "../lib/db";

const upcomingEvents = await getUpcomingEvents();
const finishedEvents = await getFinishedEvents();

// Ambil list kategori unik untuk filter
const categories = [
  "Semua",
  "RUNNING",
  "CYCLING",
  "POUNDFIT",
  "WALK",
  "TRIATHLON",
];
---

<Layout title="Platform Pendaftaran Event Olahraga No. 1">
  <!-- Centered Hero Section -->
  <section class="hero centered-hero">
    <div class="glow-spot hero-glow-1"></div>
    <div class="glow-spot hero-glow-2"></div>

    <div class="container hero-container-centered">
      <!-- Event Logo Placeholder -->
      <div class="event-logo-wrapper">
        <img
          src="/logo.webp"
          alt="Logo QRIS RUN"
          id="main-logo"
          class="event-hero-logo"
        />
      </div>

      <!-- Date & Location -->
      <div class="event-meta-pills">
        <div class="pill date-pill glass">17 Agustus 2026</div>
        <div class="pill location-pill glass">Bendung Waru Turi, Kediri</div>
      </div>

      <!-- Countdown -->
      <div class="countdown-wrapper">
        <p class="countdown-label">ACARA DIMULAI DALAM</p>

        <div id="countdown-timer" class="countdown-timer">
          <div class="time-box glass">
            <span class="time-num" id="cd-days">00</span>
            <span class="time-text">HARI</span>
          </div>
          <div class="time-box glass">
            <span class="time-num" id="cd-hours">00</span>
            <span class="time-text">JAM</span>
          </div>
          <div class="time-box glass">
            <span class="time-num" id="cd-minutes">00</span>
            <span class="time-text">MENIT</span>
          </div>
          <div class="time-box glass">
            <span class="time-num" id="cd-seconds">00</span>
            <span class="time-text">DETIK</span>
          </div>
        </div>

        <div
          id="event-started"
          class="event-started-box"
          style="display: none;"
        >
          <h2 class="started-text">EVENT STARTED</h2>
          <a href="/sertifikat" class="btn btn-accent btn-large"
            >Lihat Sertifikat</a
          >
        </div>

        <p class="kuota-text">
          Kuota terbatas! Harga Early Bird Hingga Kuota Terpenuhi.
        </p>
      </div>
    </div>

    <!-- Static Sponsors Bottom Bar -->
    <div class="sponsors-bar">
      <p class="sponsors-title"></p>
      <div class="sponsor-marquee">
        <div class="sponsor-track">
          <!-- 1. Peka -->
          <img src="/peka.webp" alt="Peka" class="sponsor-logo" />

          <!-- 2. Target QRIS -->
          <img src="/peka.webp" alt="Target QRIS" class="sponsor-logo" />

          <!-- 3. QRISNIVAL -->
          <img src="/peka.webp" alt="QRISNIVAL" class="sponsor-logo" />

          <!-- 4. BI -->
          <img src="/peka.webp" alt="BI" class="sponsor-logo" />

          <!-- 5. Syiar -->
          <img src="/peka.webp" alt="Syiar" class="sponsor-logo" />

          <!-- 6. Fekdi X IFSE -->
          <img
            src="/Road_to_FEKDI_x_IFSE.webp"
            alt="Fekdi X IFSE"
            class="sponsor-logo"
          />

          <!-- 7. 81 -->
          <img src="/81.webp" alt="81" class="sponsor-logo" />

          <!-- Duplicate for seamless scroll -->
          <!-- 1. Peka -->
          <img src="/peka.webp" alt="Peka" class="sponsor-logo" />

          <!-- 2. Target QRIS -->
          <img src="/peka.webp" alt="Target QRIS" class="sponsor-logo" />

          <!-- 3. QRISNIVAL -->
          <img src="/peka.webp" alt="QRISNIVAL" class="sponsor-logo" />

          <!-- 4. BI -->
          <img src="/peka.webp" alt="BI" class="sponsor-logo" />

          <!-- 5. Syiar -->
          <img src="/peka.webp" alt="Syiar" class="sponsor-logo" />

          <!-- 6. Fekdi X IFSE -->
          <img
            src="/Road_to_FEKDI_x_IFSE.webp"
            alt="Fekdi X IFSE"
            class="sponsor-logo"
          />

          <!-- 7. 81 -->
          <img src="/81.webp" alt="81" class="sponsor-logo" />
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="about-section" id="about">
    <div class="container about-container">
      <div class="about-content">
        <h2 class="about-title">Waru Turi Fun Run Kediri 2026</h2>
        <p class="about-desc">
          <strong>Waru Turi Fun Run 2026</strong> adalah event lomba lari rekreasi
          hasil kolaborasi luar biasa antara <strong>Radar Kediri</strong> dan <strong
            >Bank Indonesia (BI)</strong
          >, mengusung tema <em>"A Celebration of Movement in Green Scenery"</em
          >.
        </p>
        <p class="about-desc">
          Event ini dirancang khusus untuk menghadirkan semangat kebersamaan,
          gaya hidup sehat, dan sportivitas bagi seluruh peserta dari berbagai
          kalangan, sambil menikmati udara segar di kawasan Bendung Waru Turi.
        </p>
        <p class="about-desc">
          Tidak sekadar berlari, kami juga memadukan olahraga dengan aksi
          kepedulian lingkungan nyata melalui kegiatan <strong
            >penanaman pohon</strong
          >. Event ini diharapkan memberikan dampak positif berkelanjutan bagi
          kelestarian alam Kediri.
        </p>
      </div>
      <div class="about-image-wrapper">
