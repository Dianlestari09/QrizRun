<script>
  // Countdown Timer Logic
  const targetDate = new Date("2026-08-17T06:00:00+07:00").getTime();

  const timer = setInterval(() => {
    const now = new Date().getTime();
    const distance = targetDate - now;

    if (distance < 0) {
      clearInterval(timer);
      const timerElement = document.getElementById("countdown-timer");
      const startedElement = document.getElementById("event-started");
      if (timerElement) timerElement.style.display = "none";
      if (startedElement) startedElement.style.display = "flex";
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
    );
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    const dEl = document.getElementById("cd-days");
    const hEl = document.getElementById("cd-hours");
    const mEl = document.getElementById("cd-minutes");
    const sEl = document.getElementById("cd-seconds");

    if (dEl) dEl.innerText = days.toString().padStart(2, "0");
    if (hEl) hEl.innerText = hours.toString().padStart(2, "0");
    if (mEl) mEl.innerText = minutes.toString().padStart(2, "0");
    if (sEl) sEl.innerText = seconds.toString().padStart(2, "0");
  }, 1000);

  // Filter Kategori Logic
  const filterButtons = document.querySelectorAll(".filter-btn");
  const eventItems = document.querySelectorAll(".event-item-wrapper");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      // Hapus active class dari semua button
      filterButtons.forEach((btn) => btn.classList.remove("active"));

      // Tambah active class ke button yang diklik
      button.classList.add("active");

      const targetCategory = button.getAttribute("data-category");

      eventItems.forEach((item) => {
        const itemCategory = item.getAttribute("data-item-category");
        if (targetCategory === "SEMUA" || itemCategory === targetCategory) {
          (item as HTMLElement).style.display = "block";
          // Animasi fade in
          (item as HTMLElement).style.opacity = "1";
          (item as HTMLElement).style.transform = "scale(1)";
        } else {
          (item as HTMLElement).style.display = "none";
        }
      });
    });
  });

  // FAQ Logic
  const faqItems = document.querySelectorAll(".faq-item");
  faqItems.forEach((item) => {
    const btn = item.querySelector(".faq-question");
    btn?.addEventListener("click", () => {
      // Menutup FAQ lain yang sedang terbuka
      faqItems.forEach((otherItem) => {
        if (otherItem !== item) {
          otherItem.classList.remove("active");
        }
      });

      // Toggle FAQ yang diklik
      item.classList.toggle("active");
    });
  });
</script>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    padding: 6rem 0 0 0;
    overflow: hidden;
  }

  .hero-glow-1 {
    top: -10%;
    right: -10%;
    width: 500px;
    height: 500px;
    background-color: var(--accent-secondary);
  }

  .hero-glow-2 {
    bottom: -20%;
    left: -10%;
    width: 400px;
    height: 400px;
    background-color: var(--primary);
  }

  .hero-container-centered {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }

  .event-logo-wrapper {
    margin-bottom: 1rem;
    width: 100%;
    max-width: 600px;
  }

  .event-hero-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.5));
  }

  .event-meta-pills {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pill {
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
  }

  .countdown-wrapper {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .countdown-label {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .countdown-timer {
    display: flex;
    gap: 1.5rem;
  }

  .time-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 90px;
    height: 90px;
    border-radius: var(--radius-md);
    background: rgba(18, 22, 32, 0.7);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-md);
  }

  .time-num {
    font-size: 2.5rem;
    font-weight: 800;
    font-family: var(--font-display);
    color: var(--text-primary);
    line-height: 1;
  }

  .time-text {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: 0.25rem;
    letter-spacing: 1px;
  }

  .event-started-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .started-text {
    font-size: 3rem;
    font-family: var(--font-display);
    color: var(--accent);
    text-transform: uppercase;
